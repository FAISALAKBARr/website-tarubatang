generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  password           String
  phone              String?
  address            String?
  role               Role         @default(USER)
  status             Status       @default(ACTIVE)
  avatar             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  handledSubmissions Submission[] @relation("SubmissionHandler")
  umkmProducts       UMKM[]

  @@map("users")
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  description String
  content     String?
  price       String
  facilities  String[]
  location    String
  latitude    Float?
  longitude   Float?
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contact     String?

  @@map("destinations")
}

model Event {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  description         String
  content             String?
  category            String
  date                DateTime
  endDate             DateTime?
  location            String
  maxParticipants     Int?
  currentParticipants Int       @default(0)
  price               String?
  images              String[]
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("events")
}

model UMKM {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  price       String
  stock       Int?
  images      String[]
  contact     String
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  pemilik     String   @default("Pemilik tidak diketahui")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("umkm")
}

model Basecamp {
  id                   String   @id @default(cuid())
  namaBasecamp         String
  fasilitas            String[]
  dayaTampungKendaraan Int
  dayaTampungOrang     Int
  nomorWa              String
  sosialMedia          String[]
  lokasi               String
  latitude             Float?
  longitude            Float?
  pemilik              String
  menuMakanan          String[]
  menuMinuman          String[]
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  images               String[]

  @@map("basecamps")
}

model Submission {
  id         String             @id @default(cuid())
  name       String
  email      String
  message    String
  type       SubmissionType     @default(GUESTBOOK)
  status     SubmissionStatus   @default(PENDING)
  response   String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  handlerId  String?
  ipAddress  String?
  phone      String?
  priority   SubmissionPriority @default(NORMAL)
  readAt     DateTime?
  responseAt DateTime?
  responseBy String?
  source     String?
  subject    String?
  userAgent  String?
  handler    User?              @relation("SubmissionHandler", fields: [handlerId], references: [id])

  @@index([email])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@map("submissions")
}

model Analytics {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  pageViews Int      @default(0)
  visitors  Int      @default(0)
  page      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, page])
  @@map("analytics")
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  images      String[]
  category    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@index([createdAt])
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionType {
  GUESTBOOK
  VOLUNTEER
  FEEDBACK
  COMPLAINT
  BUSINESS
  INQUIRY
  OTHER
}

enum SubmissionStatus {
  PENDING
  READ
  REPLIED
  CLOSED
  ARCHIVED
}

enum SubmissionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
